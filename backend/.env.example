# Recommended. Yahoo Finance and Stooq both block a lot of cloud/serverless
# IPs (Vercel included), so this app uses Twelve Data as its primary price
# source. Get a free API key (no credit card) at:
#   https://twelvedata.com/pricing  ->  "Basic" / free tier  ->  API Keys
# Without this set, the app falls back to Stooq/yfinance, which may or may
# not work depending on whether your host's IP is currently blocked.
TWELVEDATA_API_KEY=

# Optional. If set, the /api/analyze endpoint calls the Anthropic API in
# real time to phrase the beginner-friendly interpretations more naturally.
# Without it, the app still works fully — it just uses the built-in
# rule-based English/French templates in backend/main.py.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-4-5-20250929 if unset. Point this at
# whatever Claude model your Anthropic account has access to (e.g. the
# current claude-sonnet-5 string once you've confirmed availability).
ANTHROPIC_MODEL=